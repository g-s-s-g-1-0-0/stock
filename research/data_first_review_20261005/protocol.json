  "primary": "10-session next-open to close price return minus 0.4% costs",
  "sensitivity_horizons": [
    5,
    20
  ],
  "coverage": "actual observed 48 stocks; not historical current-survivor backtest",
  "features": "saved technical values, archived financial values available before D close, recorded intraday snapshots available by D close; dated supplemental prices",
